    <worksheet name='Campaign Efficiency Matrix'>
      <table>
        <view>
          <datasources>
            <datasource caption='ads_performance_tableau' name='federated.05gljv806mlwkl121hf2v1l7pmlk' />
          </datasources>
          <datasource-dependencies datasource='federated.05gljv806mlwkl121hf2v1l7pmlk'>
            <column caption='CTR' datatype='real' name='[Calculation_6112510636110331904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([clicks]) / SUM([impressions])' />
            </column>
            <column caption='CPC' datatype='real' name='[Calculation_6112510636110417921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([spend]) / SUM([clicks])' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_6112510636110508034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders]) / SUM([clicks])' />
            </column>
            <column caption='ACOS' datatype='real' name='[Calculation_6112510636110614531]' role='measure' type='quantitative'>
